rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client reads for overlay/listeners; all writes go through the API (Admin SDK).
    match /heroes/{heroId} {
      allow read: if true;
      allow write: if false;
    }
    match /battlefields/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /raidInstances/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /dungeonInstances/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /battlefieldQueues/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /guilds/{guildId} {
      allow read: if true;
      allow write: if false;
    }
    match /streamerSettings/{id} {
      allow read: if false;
      allow write: if false;
    }
    match /twitchCredentials/{id} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read, write: if false;
    }
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }
    match /mail/{mailId} {
      allow read, write: if false;
    }
    match /auctionListings/{listingId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
