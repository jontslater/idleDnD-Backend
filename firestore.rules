rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All game state is mutated through the backend API (Admin SDK).
    match /heroes/{heroId} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read, write: if false;
    }
    match /twitchCredentials/{twitchUserId} {
      allow read, write: if false;
    }
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }
    match /mail/{mailId} {
      allow read, write: if false;
    }
    match /auctionListings/{listingId} {
      allow read, write: if false;
    }
    match /guilds/{guildId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
